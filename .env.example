# E-Invoice Copilot settings. Copy to .env (git-ignored) or set as environment variables.

# Any OpenAI-compatible server. LM Studio's default port is 1234; this project uses 1235.
# In docker compose the default is http://host.docker.internal:1235/v1 (the host machine).
LLM_BASE_URL=http://localhost:1235/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=120
# "none" skips the model's hidden reasoning; leave empty for the model's default.
LLM_REASONING_EFFORT=none

# Storage (created on first start)
APP_DB=data/app.sqlite

# "Today" for questions without a date, e.g. 2026-05-15 (tests, evals, a repeatable demo). Empty = the real date.
FROZEN_TODAY=

# Largest invoice upload in KB.
MAX_UPLOAD_KB=512
