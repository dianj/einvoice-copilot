# E-Invoice Copilot settings. Copy to .env (git-ignored) or set as environment variables.

# Any OpenAI-compatible server. LM Studio's default port is 1234; this project uses 1235.
# In docker compose the default is http://host.docker.internal:1235/v1 (the host machine).
LLM_BASE_URL=http://localhost:1235/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=120
# "none" skips the model's hidden reasoning; leave empty for the model's default.
LLM_REASONING_EFFORT=none

# Knowledge base. EMBEDDER: onnx (CPU, downloaded once) or fake (tests). The model and hybrid ranking were chosen
# with evals/retrieval_benchmark.py (see evals/results/retrieval.md).
EMBEDDER=onnx
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_CACHE_DIR=data/fastembed
CHROMA_PATH=data/chroma
HYBRID_SEARCH=1

# Storage (created on first start). CHECKPOINT_DB keeps the assistant's conversations (LangGraph checkpoints).
APP_DB=data/app.sqlite
CHECKPOINT_DB=data/checkpoints.sqlite
ATTACHMENTS_DIR=data/attachments
# Earlier messages the router sees (follow-up questions such as "and on 1 July?").
HISTORY_TURNS=6

# "Today" for questions without a date, e.g. 2026-05-15 (tests, evals, a repeatable demo). Empty = the real date.
FROZEN_TODAY=

# Largest invoice upload in KB.
MAX_UPLOAD_KB=512
